[
  {
    "id": "flow-financial-sentiment",
    "type": "tab",
    "label": "Financial Sentiment Dashboard",
    "disabled": false,
    "info": "Flow to visualize analyzed events and alerts from the MQTT pipeline."
  },
  {
    "id": "broker-config",
    "type": "mqtt-broker",
