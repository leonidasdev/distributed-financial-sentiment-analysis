# NewsAPI setup:
# 1. Create a NewsAPI account and generate an API key.
# 2. Paste the key below.
NEWSAPI_KEY=
NEWSAPI_USER_AGENT=financial-sentiment-demo/1.0
NEWSAPI_USE_MOCK=true
NEWSAPI_QUERY=stocks OR markets OR earnings OR inflation OR rates OR technology
NEWSAPI_LANGUAGE=en
NEWSAPI_SORT_BY=publishedAt
NEWSAPI_PAGE_SIZE=1
NEWS_TICKERS=NVDA,AMD,TSM,AVGO,INTC,MSFT,GOOGL,AMZN,META,AAPL,PLTR,SNOW,ORCL
NEWS_SOURCES=Reuters,Bloomberg,CNBC,Financial Times,The Wall Street Journal
NEWS_KEYWORDS=stocks,markets,earnings,inflation,rates,technology
NEWS_INTERVAL_MIN=60
NEWS_INTERVAL_MAX=120
NEWS_STATUS_TOPIC=news/status/producer
NEWS_RAW_TOPIC=news/articles/raw
NEWS_ANALYZED_TOPIC=news/articles/analyzed
NEWS_ALERT_TOPIC=news/alerts
MQTT_HOST=broker-mqtt
MQTT_PORT=1883
MONGO_URI=mongodb://db-mongodb:27017
MONGO_DB=news_analytics
RAW_COLLECTION=raw_articles
ANALYZED_COLLECTION=sentiment_analyzed